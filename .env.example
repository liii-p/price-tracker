# SQLite database file (relative to the project root)
DATABASE_URL="file:./dev.db"

# Email alerts via Resend (https://resend.com). Leave RESEND_API_KEY empty to log emails to the console instead.
RESEND_API_KEY=""
ALERT_EMAIL="you@example.com"
EMAIL_FROM="Price Tracker <onboarding@resend.dev>"

# How often to check prices (cron syntax). Default: every 6 hours.
CHECK_CRON="0 */6 * * *"

# Secret for triggering a check from an external scheduler: POST /api/check with header x-cron-secret
CRON_SECRET="replace-with-another-random-string"

# Public base URL of the app, used for links in alert emails
APP_URL="http://localhost:3000"
